{
    "manifest_version": 3,
    "name": "Smooth Auto Scroller",
    "version": "1.0",
    "description": "Automatically scrolls webpages smoothly at a configurable speed.",
    "permissions": [
      "storage",      
      "activeTab",    
      "scripting",    
      "tabs"        
    ],
    "background": {
      "service_worker": "background/service-worker.js"
    },
    "options_page": "options/options.html", 
    "action": {
      "default_popup": "popup/popup.html"
    }

  }