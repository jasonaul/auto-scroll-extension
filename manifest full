{
    "manifest_version": 3,
    "name": "Smooth Auto Scroller",
    "version": "1.0",
    "description": "Automatically scrolls webpages smoothly at a configurable speed.",
    "permissions": [
      "storage",      
      "activeTab",    
      "scripting",    
      "tabs"        
    ],
    "background": {
      "service_worker": "background/service-worker.js"
    },
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
      }
    },
    "options_page": "options/options.html",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }

  }